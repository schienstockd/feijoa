{
  "name": "feijoa",
  "version": "0.0.1",
  "description": "Hand-drawn sketch renderer + catalogue explaining cecelia features",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "author": "Dominik Schienstock",
  "repository": {
    "type": "git",
    "url": "https://github.com/schienstockd/feijoa.git"
  },
  "main": "./src/lib/index.ts",
  "module": "./src/lib/index.ts",
  "types": "./src/lib/index.ts",
  "exports": {
    ".": {
      "types": "./src/lib/index.ts",
      "import": "./src/lib/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "dev": "vite --port 5174",
    "build": "vue-tsc --noEmit && vite build",
    "build:site": "vite build --mode site",
    "build:lib": "vite build --mode lib && vue-tsc --emitDeclarationOnly --outDir dist",
    "preview": "vite preview --port 5174",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@types/animejs": "^3.1.12",
    "animejs": "^3.2.2"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vue": "^3.4.0",
    "vue-tsc": "^2.0.0"
  }
}
